# Copy this file to .env.local and fill in values from the Supabase dashboard
# (Project Settings -> API Keys). .env.local is never committed.

# Address of the atlas-dev Supabase project, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (public) key. Safe in the browser: database rules protect the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET key. Bypasses all database rules. Server only. Never share or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app runs. Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (spam check). These are Cloudflare's public TEST keys that
# always pass. Replace with real keys from dash.cloudflare.com before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random secret used to scramble visitor IP addresses before storing them.
IP_HASH_SALT=
